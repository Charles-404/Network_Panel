# Server
PORT=3001
HOST=0.0.0.0

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=network_panel
DB_USER=postgres
DB_PASSWORD=your_password

# FortiGate API (optional, will use mock data if not configured)
FORTIGATE_HOST=
FORTIGATE_TOKEN=

# SNMP Configuration (optional, for SNMP-enabled devices)
SNMP_HOST=
SNMP_COMMUNITY=public
SNMP_PORT=161
SNMP_INTERVAL=30000
SNMP_TIMEOUT=5000
SNMP_RETRIES=1

# Syslog Configuration (optional, for receiving syslog messages)
SYSLOG_ENABLED=true
SYSLOG_PORT=514
SYSLOG_HOST=0.0.0.0

# Alert Configuration (optional)
ALERT_WEBHOOK_URL=
ALERT_CHECK_INTERVAL=10000
